# Copy this file to .local/cloudflare-dev-laptop.env and fill in values.
# Do not commit .local/ files or Cloudflare credentials.

CLOUDFLARE_TUNNEL_NAME=electrahub-dev-laptop
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_CREDENTIALS_FILE=

# Public domain routed by Cloudflare.
ELECTRA_PUBLIC_DOMAIN=electrahub.net

# Existing minikube ingress host suffix.
ELECTRA_EXISTING_INGRESS_DOMAIN=electrahub.com

# Local origins created by scripts/port-forward.sh.
# HTTPS origins avoid NGINX HTTP -> HTTPS redirects. noTLSVerify is used in the rendered config.
INGRESS_ORIGIN=https://127.0.0.1:8443
ARGOCD_ORIGIN=https://127.0.0.1:9443

# Generated config output.
CLOUDFLARED_CONFIG_FILE=.local/cloudflare/dev-laptop/config.yml
