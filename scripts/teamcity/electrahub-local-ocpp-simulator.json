{
  "pipelines": [
    {
      "serviceName": "ocpp-simulator",
      "buildKind": "go",
      "teamcityProjectName": "ocpp-simulator",
      "parentProjectId": "ElectraHub",
      "projectId": "ElectraHub_OcppSimulator",
      "buildTypeId": "ElectraHub_OcppSimulator_Build",
      "vcsRootId": "ElectraHub_OcppSimulator_VcsRoot",
      "gitUrl": "https://github.com/amolsurjuse/ocpi-simulator.git",
      "gitBranch": "develop",
      "dockerImage": "amolsurjuse/ocpi-simulator",
      "dockerfilePath": "Dockerfile",
      "dockerContext": ".",
      "dockerUseBuildx": true,
      "dockerPlatforms": "linux/amd64,linux/arm64",
      "testCommand": "set -eu\ntar --exclude=.git --exclude=ui/node_modules -cf - . | docker run --rm -i golang:1.22-bookworm sh -lc 'mkdir -p /workspace && tar -xf - -C /workspace && cd /workspace && /usr/local/go/bin/go version && /usr/local/go/bin/go test ./internal/app ./internal/fleet ./internal/store ./internal/ocpi ./internal/ws'",
      "agentName": "",
      "addVcsTrigger": false,
      "deployVersionFile": "charts/config/services/ocpp-simulator/us/version/dev-version.yaml"
    }
  ]
}
