# ElectraHub prod-like laptop release settings.
# Copy to prod-laptop.env and edit values before running scripts.

export ELECTRA_ENV=prod
export ELECTRA_NAMESPACE=prod
export ELECTRA_REGION=us

# Docker-backed Kubernetes cluster.
export ELECTRA_CLUSTER_RUNTIME=k3d
export ELECTRA_CLUSTER_NAME=electrahub-prod
export ELECTRA_KUBECONTEXT=k3d-electrahub-prod
export ELECTRA_API_SERVER_HOST=127.0.0.1
export ELECTRA_API_SERVER_PORT=6445

# GitOps repository.
export ELECTRA_GIT_REPO_URL=https://github.com/amolsurjuse/k8s-platform.git
export ELECTRA_GIT_TARGET_REVISION=develop
export ELECTRA_GIT_PATH=charts/common

# Hostnames exposed by ingress on the prod-like laptop.
export ELECTRA_BASE_DOMAIN=prod.electrahub.local
export ELECTRA_API_HOST=prod.electrahub.local
export ELECTRA_DRIVER_PORTAL_HOST=driver-portal-prod.electrahub.local
export ELECTRA_ADMIN_PORTAL_HOST=admin-portal-prod.electrahub.local
export ELECTRA_OCPP_SIMULATOR_HOST=ocpp-simulator-prod.electrahub.local

# Argo CD.
# local: install/use Argo CD inside the prod laptop cluster.
# remote: register this cluster with an Argo CD instance running elsewhere.
export ELECTRA_ARGO_MODE=local
export ELECTRA_ARGO_NAMESPACE=argocd
export ELECTRA_ARGO_PROJECT=electrahub-prod
export ELECTRA_ARGO_SERVER=localhost:8080

# Image pull policy and release target.
export ELECTRA_IMAGE_PULL_POLICY=IfNotPresent
export ELECTRA_RELEASE_NAME_SUFFIX=prod

