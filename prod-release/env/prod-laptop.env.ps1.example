# ElectraHub Prod laptop release settings for PowerShell.
# Copy to prod-laptop.env.ps1 and edit values before running scripts.

$env:ELECTRA_ENV = "prod"
$env:ELECTRA_NAMESPACE = "prod"
$env:ELECTRA_REGION = "us"

# Docker-backed Kubernetes cluster.
$env:ELECTRA_CLUSTER_RUNTIME = "k3d"
$env:ELECTRA_CLUSTER_NAME = "electrahub-prod"
$env:ELECTRA_KUBECONTEXT = "k3d-electrahub-prod"
$env:ELECTRA_API_SERVER_HOST = "127.0.0.1"
$env:ELECTRA_API_SERVER_PORT = "6445"

# GitOps repository.
$env:ELECTRA_GIT_REPO_URL = "https://github.com/amolsurjuse/k8s-platform.git"
$env:ELECTRA_GIT_TARGET_REVISION = "develop"
$env:ELECTRA_GIT_PATH = "charts/common"

# Hostnames exposed by ingress on the Prod laptop.
$env:ELECTRA_BASE_DOMAIN = "prod.electrahub.local"
$env:ELECTRA_API_HOST = "prod.electrahub.local"
$env:ELECTRA_DRIVER_PORTAL_HOST = "driver-portal-prod.electrahub.local"
$env:ELECTRA_ADMIN_PORTAL_HOST = "admin-portal-prod.electrahub.local"
$env:ELECTRA_OCPP_SIMULATOR_HOST = "ocpp-simulator-prod.electrahub.local"

# Argo CD.
# local: install/use Argo CD inside the prod laptop cluster.
# remote: register this cluster with an Argo CD instance running elsewhere.
$env:ELECTRA_ARGO_MODE = "local"
$env:ELECTRA_ARGO_NAMESPACE = "argocd"
$env:ELECTRA_ARGO_PROJECT = "electrahub-prod"
$env:ELECTRA_ARGO_SERVER = "localhost:8080"

# Image pull policy and release target.
$env:ELECTRA_IMAGE_PULL_POLICY = "IfNotPresent"
$env:ELECTRA_RELEASE_NAME_SUFFIX = "prod"
