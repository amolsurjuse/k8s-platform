# ElectraHub local k3d environment settings for PowerShell.
# Copy to local-k3d.env.ps1 and edit if needed.

$env:ELECTRA_DEV_ENV = "dev"
$env:ELECTRA_DEV_NAMESPACE = "dev"
$env:ELECTRA_DEV_CLUSTER_NAME = "electrahub-dev"
$env:ELECTRA_DEV_KUBECONTEXT = "k3d-electrahub-dev"
$env:ELECTRA_DEV_ARGO_PROJECT = "electrahub-dev"
$env:ELECTRA_DEV_TUNNEL_NAME = "electrahub-dev-tunnel"

$env:ELECTRA_PROD_ENV = "prod"
$env:ELECTRA_PROD_NAMESPACE = "prod"
$env:ELECTRA_PROD_CLUSTER_NAME = "electrahub-prod"
$env:ELECTRA_PROD_KUBECONTEXT = "k3d-electrahub-prod"
$env:ELECTRA_PROD_ARGO_PROJECT = "electrahub-prod"
$env:ELECTRA_PROD_TUNNEL_NAME = "electrahub-prod-tunnel"

$env:ELECTRA_ARGO_NAMESPACE = "argocd"
$env:ELECTRA_GIT_REPO_URL = "https://github.com/amolsurjuse/k8s-platform.git"
$env:ELECTRA_GIT_TARGET_REVISION = "develop"
$env:ELECTRA_GIT_PATH = "charts/common"

$env:ELECTRA_ROOT_DOMAIN = "electrahub.net"
$env:ELECTRA_DEV_BASE_HOST = "dev.electrahub.net"
$env:ELECTRA_DEV_API_HOST = "api-dev.electrahub.net"
$env:ELECTRA_DEV_ARGO_HOST = "argocd-dev.electrahub.net"
$env:ELECTRA_PROD_BASE_HOST = "electrahub.net"
$env:ELECTRA_PROD_WWW_HOST = "www.electrahub.net"
$env:ELECTRA_PROD_API_HOST = "api.electrahub.net"
$env:ELECTRA_PROD_ARGO_HOST = "argocd.electrahub.net"
